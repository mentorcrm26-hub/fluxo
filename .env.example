# ==============================================================================
# FLUXO — VARIÁVEIS DE AMBIENTE
# ==============================================================================

# String de conexão com o banco de dados PostgreSQL
DATABASE_URL=postgresql://fluxo_user:sua_senha_segura@fluxo-db:5432/fluxo_db?schema=public

# Fuso horário do servidor
TZ=America/Sao_Paulo

# Ambiente de execução
NODE_ENV=production

# Nome público da aplicação
NEXT_PUBLIC_APP_NAME=Fluxo

# Fonte de dados padrão ('local' para desenvolvimento offline, ou omitir para API/banco)
# NEXT_PUBLIC_FONTE_DADOS=local

# Autenticação HTTP Basic Auth para proteção de acesso
AUTH_USUARIO=admin
AUTH_SENHA=sua_senha_forte_aqui
